<?xml version="1.0" encoding="UTF-8"?>
<!--
  Run Netprobe natively on macOS as a per-user LaunchAgent (the user needs a login session, e.g.
  automatic login on a headless Mac). Replace USER_HOME with the user's home directory, then:

    cp deploy/dev.netprobe.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.netprobe.plist

  Requires Node.js 24+ at the path below; curl and ping ship with macOS.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.netprobe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>src/server/main.ts</string>
  </array>
  <key>WorkingDirectory</key><string>USER_HOME/netprobe</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- No proxy variables: probes take the path their exit names. -->
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NODE_ENV</key><string>production</string>
    <key>NETPROBE_PORT</key><string>8080</string>
    <key>NETPROBE_CONFIG</key><string>USER_HOME/netprobe/config/netprobe.yaml</string>
    <key>NETPROBE_DATA</key><string>USER_HOME/netprobe/data/netprobe.db</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>USER_HOME/Library/Logs/netprobe.log</string>
  <key>StandardErrorPath</key><string>USER_HOME/Library/Logs/netprobe.log</string>
</dict>
</plist>
