    "services": {
      "default": [],
      "description": "Services to add, or to extend built-in services by reusing their id.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Service id. Reusing a built-in id (e.g. \"aws\") adds targets to that service or replaces targets with the same id.",
            "anyOf": [
              {
                "enum": [
                  "latency",
                  "connectivity",
                  "udp",
                  "dns-plain",
                  "dns-encrypted",
                  "speed",
                  "apple",
                  "microsoft",
                  "google",
                  "cloudflare",
                  "openai",
                  "anthropic",
                  "google-ai",
                  "xai",
                  "ai-labs",
                  "ai-china",
                  "ai-inference",
                  "ai-coding",
                  "github",
                  "github-actions",
                  "code-hosting",
                  "apple-notary",
                  "npm",
                  "registries",
                  "containers",
                  "cdn",
                  "toolchains",
                  "linux",
                  "china-mirrors",
                  "aws",
                  "vercel",
                  "tailscale",
                  "tailscale-derp",
                  "social",
                  "collaboration",
                  "china"
                ]
              },
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            ]
          },
          "name": {
            "description": "Display name. Defaults to the id.",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "One line shown next to the service name.",
            "type": "string"
          },
          "category": {
            "description": "Tab the service appears under, e.g. \"Network\" or a new one such as \"Internal\".",
            "type": "string",
            "examples": [
              "Network",
              "DNS",
              "Platforms",
              "AI",
              "Developer",
              "Packages",
              "Mirrors",
              "Cloud",
              "Tailscale",
              "Social & tools",
              "Regional"
            ]
          },
          "targets": {
            "default": [],
            "description": "Targets of this service.",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "description": "What to probe; the scheme picks the probe.\nhttp(s)://… — through curl, with DNS/TCP/TLS/TTFB timings and a status check.\nicmp://host — ping.\ntcp://host:port — TCP connect.\ndns://server[:port]?name=example.com&type=A — one DNS query over UDP.\ndot://server[:port]?name=example.com&sni=host — DNS over TLS.\nstun://host[:port] — STUN binding; reports the public UDP address.\nquic://host[:port] — QUIC version negotiation (HTTP/3, DoQ reachability)."
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "Unique within the service. Defaults to one derived from the URL host. Reuse a built-in target id to replace it.",
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "name": {
                      "description": "Display name. Defaults to the URL host.",
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "What to probe; the scheme picks the probe.\nhttp(s)://… — through curl, with DNS/TCP/TLS/TTFB timings and a status check.\nicmp://host — ping.\ntcp://host:port — TCP connect.\ndns://server[:port]?name=example.com&type=A — one DNS query over UDP.\ndot://server[:port]?name=example.com&sni=host — DNS over TLS.\nstun://host[:port] — STUN binding; reports the public UDP address.\nquic://host[:port] — QUIC version negotiation (HTTP/3, DoQ reachability)."
                    },
                    "method": {
                      "default": "GET",
                      "description": "HTTP method. HEAD avoids downloading page bodies.",
                      "type": "string",
                      "enum": [
                        "GET",
                        "HEAD"
                      ]
                    },
                    "expectStatus": {
                      "description": "Healthy HTTP status or statuses. Default 200.",
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 100,
                              "maximum": 599
                            },
                            {
                              "type": "string",
                              "enum": [
                                "2xx",
                                "3xx",
                                "4xx",
                                "5xx"
                              ]
                            }
                          ],
                          "description": "An exact HTTP status such as 200, or a class such as \"2xx\"."
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 100,
                                "maximum": 599
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "2xx",
                                  "3xx",
                                  "4xx",
                                  "5xx"
                                ]
                              }
                            ],
                            "description": "An exact HTTP status such as 200, or a class such as \"2xx\"."
                          }
                        }
                      ]
                    },
                    "check": {
                      "default": "response",
                      "description": "\"reachability\" marks endpoints that answer with an error by design (e.g. 401 without credentials): the expected status proves the path, not that real requests would work.",
                      "type": "string",
                      "enum": [
                        "response",
                        "reachability"
                      ]
                    },
                    "followRedirects": {
                      "description": "Follow redirects. Default: only for downloads.",
                      "type": "boolean"
                    },
                    "headers": {
                      "description": "Extra request headers (HTTP only).",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
