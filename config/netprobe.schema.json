{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Netprobe configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path or URL of this file’s JSON Schema.",
      "type": "string"
    },
    "hostLabel": {
      "description": "Name shown in the UI and stored with each run. Defaults to the hostname.",
      "type": "string"
    },
    "modules": {
      "description": "Turn optional parts of Netprobe on or off.",
      "default": {},
      "type": "object",
      "properties": {
        "downloads": {
          "default": false,
          "description": "Download throughput tests against a few speed-test hosts (about 50 MB per run). Off by default: every viewer could start one, and they use the host’s bandwidth.",
          "type": "boolean"
        },
        "host": {
          "default": true,
          "description": "The Host page: system details, interfaces, routes, DNS, and proxy settings, visible to anyone who can open Netprobe.",
          "type": "boolean"
        },
        "egress": {
          "default": true,
          "description": "The Egress page: asks third-party services about this host’s public addresses. true, false, or settings.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "excludeSources": {
                  "default": [],
                  "description": "Third-party IP information services not to query.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "cloudflare",
                      "ipify",
                      "ipleak",
                      "ipinfo",
                      "ip-api",
                      "ipapi-is",
                      "ipwho",
                      "ip-sb",
                      "ipapi-co",
                      "geojs",
                      "ipquery",
                      "ifconfig-co",
                      "ipip",
                      "myip-la"
                    ]
                  }
                },
                "reputation": {
                  "default": true,
                  "description": "Look up each exit address on proxycheck.io (type, VPN/proxy flags, risk).",
                  "type": "boolean"
                },
                "dnsLeakTest": {
                  "default": true,
                  "description": "Run the bash.ws DNS leak test in addition to the whoami TXT lookups.",
                  "type": "boolean"
                },
                "browserCheck": {
                  "default": true,
                  "description": "Offer the WebRTC and public-address check for the browser viewing the page.",
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "description": "Egress page settings."
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "probe": {
      "description": "Quick-mode probing.",
      "default": {},
      "type": "object",
      "properties": {
        "repeats": {
          "default": 5,
          "description": "Default attempts per target.",
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "connectTimeoutMs": {
          "default": 5000,
          "description": "Connection timeout per attempt.",
          "type": "integer",
          "minimum": 500,
          "maximum": 60000
        },
        "timeoutMs": {
          "default": 15000,
          "description": "Total time limit per attempt.",
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "concurrency": {
          "default": 8,
          "description": "Targets probed in parallel. Downloads always run one at a time.",
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "additionalProperties": false
    },
    "download": {
      "description": "Download-mode limits.",
      "default": {},
      "type": "object",
      "properties": {
        "connections": {
          "default": 4,
          "description": "Connections for the parallel measurement.",
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        },
        "timeoutMs": {
          "default": 120000,
          "description": "Time limit per download.",
          "type": "integer",
          "minimum": 5000,
          "maximum": 600000
        },
        "maxBytes": {
          "default": 209715200,
          "description": "Hard cap per request; larger files are aborted rather than downloaded.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "ipFamily": {
      "default": "auto",
      "description": "Default IP family for runs; each run can override it.",
      "type": "string",
      "enum": [
        "auto",
        "ipv4",
        "ipv6"
      ]
    },
    "publicIpCheckUrl": {
      "default": "https://www.cloudflare.com/cdn-cgi/trace",
      "description": "Echoes the public IP (as `ip=` lines or a bare address); recorded with every run.",
      "type": "string",
      "format": "uri"
    },
    "exits": {
      "default": [
        {
          "id": "direct",
          "name": "Direct"
        }
      ],
      "description": "Network exits to compare. The first is the default.",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Exit id, stored with every run. Lowercase letters, digits, and dashes."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Shown in the egress picker."
          },
          "proxy": {
            "description": "http://, https://, socks5:// (DNS resolved locally), or socks5h:// (DNS resolved by the proxy). Only HTTP probes can use a proxy. Credentials in the URL are never shown or logged.",
            "type": "string",
            "format": "uri"
          },
          "interface": {
            "description": "Bind every probe of this exit to a network interface (e.g. \"wg0\"), using the routes it already has. curl and ping bind to the device; socket probes bind to its address.",
            "type": "string",
            "minLength": 1
          },
          "gateway": {
            "description": "Send this exit through a gateway on a directly connected network, such as a LAN side router. In Docker the container sets up policy routing for it at start (needs the NET_ADMIN capability), so only this exit uses the gateway.",
            "type": "string",
            "format": "ipv4",
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
          },
          "dns": {
            "description": "Resolve names for this exit with this DNS server, queried through the exit itself. Useful when the gateway hands out fake IPs and routes by domain.",
            "anyOf": [
              {
                "type": "string",
                "format": "ipv4",
                "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
              },
              {
                "type": "string",
                "format": "ipv6",
                "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
              }
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "description": "A network exit runs can be sent through. Without proxy, interface, or gateway it uses the system routing."
      }
    },
    "presets": {
      "description": "The built-in services.",
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Set to false to start from no built-in services at all.",
